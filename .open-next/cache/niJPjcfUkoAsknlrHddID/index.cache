n\" content=\"Украшения из натурального камня — нефрит, агат, кварц, перламутр — с элементами металла и декоративных бусин. Ручная работа на заказ.\"/><meta name=\"generator\" content=\"v0.app\"/><link rel=\"icon\" href=\"/icon-light-32x32.png\" media=\"(prefers-color-scheme: light)\"/><link rel=\"icon\" href=\"/icon-dark-32x32.png\" media=\"(prefers-color-scheme: dark)\"/><link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\"/><link rel=\"apple-touch-icon\" href=\"/apple-icon.png\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"font-sans antialiased overflow-x-hidden\"><div hidden=\"\"><!--$--><!--/$--></div><div class=\"noise\"></div><main><header class=\"fixed top-0 left-0 right-0 z-50 mix-blend-difference\"><div class=\"flex items-center justify-between px-6 py-6 md:px-12\"><a class=\"group\" href=\"/\"><span class=\"whitespace-nowrap text-xl font-bold tracking-[0.3em] text-white\">ÁCCENTS</span></a><nav class=\"hidden md:flex items-center gap-12\"><a class=\"text-sm tracking-widest uppercase text-white hover:opacity-60 transition-opacity\" href=\"#lookbook\">Lookbook</a><a class=\"text-sm tracking-widest uppercase text-white hover:opacity-60 transition-opacity\" href=\"#catalog\">Каталог</a><a class=\"text-sm tracking-widest uppercase text-white hover:opacity-60 transition-opacity\" href=\"#about\">О нас</a><a class=\"text-sm tracking-widest uppercase text-white hover:opacity-60 transition-opacity\" href=\"#process\">Процесс</a><a class=\"text-sm tracking-widest uppercase text-white hover:opacity-60 transition-opacity\" href=\"#contact\">Контакт</a></nav><div class=\"flex items-center gap-6\"><a class=\"relative text-white\" href=\"#cart\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shopping-bag h-5 w-5\" aria-hidden=\"true\"><path d=\"M16 10a4 4 0 0 1-8 0\"></path><path d=\"M3.103 6.034h17.794\"></path><path d=\"M3.4 5.467a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.667a2 2 0 0 0-.4-1.2l-2-2.667A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z\"></path></svg></a><button class=\"md:hidden text-white\" aria-label=\"Открыть меню\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu h-6 w-6\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg></button></div></div></header><section class=\"relative min-h-screen flex flex-col justify-between overflow-hidden\"><div class=\"absolute inset-0 bg-background\"></div><svg class=\"leaf-shadow absolute top-[-6%] right-[3%] w-[480px] h-[820px] pointer-events-none\" viewBox=\"0 0 400 700\" style=\"transform-origin:50% 50%\"><defs><path id=\"leaf-lance\" d=\"M0,-68 C22,-62 26,-15 24,20 C22,50 12,68 0,72 C-12,68 -22,50 -24,20 C-26,-15 -22,-62 0,-68 Z\"></path><path id=\"leaf-sliver\" d=\"M0,-58 C10,-53 12,-12 11,18 C10,42 5,58 0,62 C-5,58 -10,42 -11,18 C-12,-12 -10,-53 0,-58 Z\"></path></defs><g transform=\"rotate(38 200 350)\"><path d=\"M200 660 C 198 560, 202 460, 198 360 C 196 300, 200 230, 205 150 C 208 110, 215 80, 225 50\" stroke=\"#3d3a2f\" stroke-width=\"5\" fill=\"none\" stroke-linecap=\"round\"></path><use href=\"#leaf-lance\" transform=\"translate(222 45) rotate(-8) scale(1.15)\"></use><use href=\"#leaf-lance\" transform=\"translate(268 95) rotate(38) scale(1.0)\"></use><use href=\"#leaf-sliver\" transform=\"translate(245 110) rotate(8) scale(0.7)\"></use><use href=\"#leaf-sliver\" transform=\"translate(230 130) rotate(-15) scale(0.55)\"></use><use href=\"#leaf-lance\" transform=\"translate(118 205) rotate(-45) scale(1.35)\"></use><use href=\"#leaf-lance\" transform=\"translate(270 255) rotate(35) scale(1.2)\"></use><use href=\"#leaf-lance\" transform=\"translate(150 330) rotate(-30) scale(1.5)\"></use><use href=\"#leaf-sliver\" transform=\"translate(95 415) rotate(-58) scale(1.1)\"></use><use href=\"#leaf-sliver\" transform=\"translate(70 500) rotate(-65) scale(1.0)\"></use><use href=\"#leaf-lance\" transform=\"translate(285 420) rotate(48) scale(1.05)\"></use><use href=\"#leaf-lance\" transform=\"translate(180 545) rotate(20) scale(1.3)\"></use><use href=\"#leaf-lance\" transform=\"translate(228 555) rotate(-18) scale(1.25)\"></use></g></svg><div class=\"relative z-10 flex-1 flex flex-col justify-center px-6 md:px-12 pt-32\" style=\"opacity:1;transform:none\"><div class=\"max-w-[95vw]\"><p class=\"text-primary text-sm md:text-base tracking-[0.3em] uppercase mb-6\" style=\"opacity:0;transform:translateY(20px)\">Украшения ручной работы</p><h1 class=\"text-[12vw] md:text-[10vw] lg:text-[8vw] font-bold leading-[0.85] tracking-tight uppercase\"><span class=\"block\" style=\"opacity:0;transform:translateY(100px)\">Носи</span><span class=\"block text-primary\" style=\"opacity:0;transform:translateY(100px)\">Смыслы</span></h1><p class=\"mt-8 text-muted-foreground max-w-md text-lg\" style=\"opacity:0\">У каждого смысла — своя форма, как и у наших украшений. В основе каждого — крупные натуральные камни и сборка в единственном экземпляре.</p></div><div class=\"mt-12\" style=\"opacity:0;transform:translateY(20px)\"><a class=\"group inline-flex items-center gap-4 text-primary hover:text-primary/80 transition-colors\" href=\"#catalog\"><span class=\"text-sm uppercase tracking-[0.2em]\">Смотреть каталог</span><span class=\"flex items-center justify-center w-12 h-12 border border-primary group-hover:bg-primary group-hover:text-primary-foreground transition-all\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-down-right h-5 w-5\" aria-hidden=\"true\"><path d=\"m7 7 10 10\"></path><path d=\"M17 7v10H7\"></path></svg></span></a></div></div><div class=\"relative z-20 bg-background border-t border-border py-4 overflow-hidden\"><div class=\"animate-marquee flex whitespace-nowrap\"><span class=\"text-sm uppercase tracking-[0.3em] text-muted-foreground mx-8\">Натуральные камни — Единственный экземпляр — Проверенные материалы — Ручная работа — Качественная фурнитура —</span><span class=\"text-sm uppercase tracking-[0.3em] text-muted-foreground mx-8\">Натуральные камни — Единственный экземпляр — Проверенные материалы — Ручная работа — Качественная фурнитура —</span><span class=\"text-sm uppercase tracking-[0.3em] text-muted-foreground mx-8\">Натуральные камни — Единственный экземпляр — Проверенные материалы — Ручная работа — Качественная фурнитура —</span><span class=\"text-sm uppercase tracking-[0.3em] text-muted-foreground mx-8\">Натуральные камни — Единственный экземпляр — Проверенные материалы — Ручная работа — Качественная фурнитура —</span></div></div><div class=\"absolute bottom-24 right-6 md:right-12 flex flex-col items-center gap-2\" style=\"opacity:0\"><span class=\"text-xs uppercase tracking-widest text-muted-foreground hidden md:block\" style=\"writing-mode:vertical-rl;transform:rotate(180deg)\">Скролл</span><div class=\"w-px h-16 bg-gradient-to-b from-primary to-transparent\"></div></div></section><section id=\"lookbook\" class=\"relative py-32 md:py-48\"><div class=\"px-6 md:px-12 mb-16 md:mb-24\"><div class=\"flex flex-col md:flex-row md:items-end md:justify-between gap-8\"><div><span class=\"text-primary text-sm tracking-[0.3em] uppercase\" style=\"opacity:0\">01 / LOOKBOOK</span><h2 class=\"text-5xl md:text-7xl lg:text-8xl font-bold uppercase mt-4\" style=\"opacity:0;transform:translateY(40px)\">Мастерская</h2></div><p class=\"text-muted-foreground max-w-sm text-lg\" style=\"opacity:0\">Три взгляда на одну мастерскую: то, что рождается, то, что выходит новым, и то, как это живёт дальше.</p></div></div><div class=\"px-6 md:px-12\"><div class=\"grid grid-cols-1 md:grid-cols-12 gap-4\"><div class=\"\n                relative group overflow-hidden bg-card\n                md:col-span-7 aspect-[4/3] md:aspect-[16/10]\n                \n                \n              \" style=\"opacity:0;transform:translateY(60px)\"><a class=\"block h-full\" href=\"#category-1\"><img alt=\"Тизер\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover transition-transform duration-700 group-hover:scale-105\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://picsum.photos/seed/accents-stones/1200/800\"/><div class=\"absolute inset-0 bg-gradient-to-t from-background via-background/20 to-transparent opacity-80\"></div><div class=\"absolute inset-0 p-6 md:p-8 flex flex-col justify-between\"><div class=\"flex justify-between items-start\"><span class=\"text-xs tracking-[0.2em] uppercase text-muted-foreground\">Behind the scenes</span><span class=\"flex items-center justify-center w-10 h-10 border border-foreground/20 opacity-0 group-hover:opacity-100 transition-all group-hover:border-primary group-hover:bg-primary group-hover:text-primary-foreground\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right h-4 w-4\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></span></div><div><span class=\"text-primary text-xs tracking-widest uppercase\">В процессе</span><h3 class=\"text-4xl md:text-5xl lg:text-6xl font-bold uppercase mt-2 group-hover:text-primary transition-colors\">Тизер</h3><p class=\"text-muted-foreground mt-3 max-w-md\">Украшения в процессе: инструменты, руки, полусобранные вещи — то, что обычно не видно</p></div></div></a></div><div class=\"\n                relative group overflow-hidden bg-card\n                \n                md:col-span-5 aspect-[4/3] md:aspect-[4/5]\n                \n              \" style=\"opacity:0;transform:translateY(60px)\"><a class=\"block h-full\" href=\"#category-2\"><img alt=\"Дроп\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover transition-transform duration-700 group-hover:scale-105\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://picsum.photos/seed/accents-metal/1200/800\"/><div class=\"absolute inset-0 bg-gradient-to-t from-background via-background/20 to-transparent opacity-80\"></div><div class=\"absolute inset-0 p-6 md:p-8 flex flex-col justify-between\"><div class=\"flex justify-between items-start\"><span class=\"text-xs tracking-[0.2em] uppercase text-muted-foreground\">На вид съедобное</span><span class=\"flex items-center justify-center w-10 h-10 border border-foreground/20 opacity-0 group-hover:opacity-100 transition-all group-hover:border-primary group-hover:bg-primary group-hover:text-primary-foreground\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right h-4 w-4\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></span></div><div><span class=\"text-primary text-xs tracking-widest uppercase\">Скоро</span><h3 class=\"text-4xl md:text-5xl lg:text-6xl font-bold uppercase mt-2 group-hover:text-primary transition-colors\">Дроп</h3><p class=\"text-muted-foreground mt-3 max-w-md\">Новая история украшений, которая скоро выйдет на свет</p></div></div></a></div><div class=\"\n                relative group overflow-hidden bg-card\n                \n                \n                md:col-span-12 aspect-[4/3] md:aspect-[21/9]\n              \" style=\"opacity:0;transform:translateY(60px)\"><a class=\"block h-full\" href=\"#category-3\"><img alt=\"Showreel\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover transition-transform duration-700 group-hover:scale-105\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://picsum.photos/seed/accents-beads/1200/800\"/><div class=\"absolute inset-0 bg-gradient-to-t from-background via-background/20 to-transparent opacity-80\"></div><div class=\"absolute inset-0 p-6 md:p-8 flex flex-col justify-between\"><div class=\"flex justify-between items-start\"><span class=\"text-xs tracking-[0.2em] uppercase text-muted-foreground\">Aesthetic feed</span><span class=\"flex items-center justify-center w-10 h-10 border border-foreground/20 opacity-0 group-hover:opacity-100 transition-all group-hover:border-primary group-hover:bg-primary group-hover:text-primary-foreground\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right h-4 w-4\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></span></div><div><span class=\"text-primary text-xs tracking-widest uppercase\">Смотреть</span><h3 class=\"text-4xl md:text-5xl lg:text-6xl font-bold uppercase mt-2 group-hover:text-primary transition-colors\">Showreel</h3><p class=\"text-muted-foreground mt-3 max-w-md\">Эстетика мастерской без слов: то, как мы видим свои украшения</p></div></div></a></div></div></div></section><section id=\"catalog\" class=\"relative py-32 md:py-48 bg-card\"><div class=\"px-6 md:px-12 mb-16 md:mb-24\"><div class=\"flex flex-col md:flex-row md:items-end md:justify-between gap-8\"><div><span class=\"text-primary text-sm tracking-[0.3em] uppercase\" style=\"opacity:0\">02 / Каталог</span><h2 class=\"text-5xl md:text-7xl lg:text-8xl font-bold uppercase mt-4\" style=\"opacity:0;transform:translateY(40px)\">Категории</h2><p class=\"text-muted-foreground max-w-sm text-lg mt-4\" style=\"opacity:0\">Ни одно украшение не повторяется дважды — выбирайте то, что есть сейчас.</p></div><div class=\"flex gap-4\" style=\"opacity:0\"><button class=\"px-4 py-2 text-sm uppercase tracking-widest border transition-all border-primary bg-primary text-primary-foreground\">Все</button><button class=\"px-4 py-2 text-sm uppercase tracking-widest border transition-all border-border hover:border-primary hover:text-primary\">Колье</button><button class=\"px-4 py-2 text-sm uppercase tracking-widest border transition-all border-border hover:border-primary hover:text-primary\">Браслеты</button><button class=\"px-4 py-2 text-sm uppercase tracking-widest border transition-all border-border hover:border-primary hover:text-primary\">Обвесы</button></div></div></div><div class=\"px-6 md:px-12\"><p class=\"text-muted-foreground text-center py-12\">Загружаем изделия…</p><div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-12\"></div></div><div class=\"px-6 md:px-12 mt-16 md:mt-24 text-center\" style=\"opacity:0\"><button class=\"inline-flex items-center gap-4 px-8 py-4 border border-primary text-primary hover:bg-primary hover:text-primary-foreground transition-all text-sm uppercase tracking-widest\">Смотреть все изделия<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-plus h-4 w-4\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"M12 5v14\"></path></svg></button></div></section><section id=\"process\" class=\"relative py-32 md:py-48\"><div class=\"px-6 md:px-12 mb-24 md:mb-32\"><span class=\"text-primary text-sm tracking-[0.3em] uppercase\" style=\"opacity:0\">03 / Процесс</span><h2 class=\"text-5xl md:text-7xl lg:text-8xl font-bold uppercase mt-4\" style=\"opacity:0;transform:translateY(40px)\">Как рождается<br/><span class=\"text-primary\">украшение</span></h2></div><div class=\"px-6 md:px-12\"><div class=\"relative max-w-4xl mx-auto\"><div class=\"absolute left-0 md:left-1/2 top-0 bottom-0 w-px bg-border\"><div class=\"w-full bg-primary origin-top\" style=\"height:0%\"></div></div><div class=\"space-y-24 md:space-y-32\"><div class=\"relative flex flex-col md:flex-row gap-8 md:gap-16 md:flex-row\" style=\"opacity:0;transform:translateY(40px)\"><div class=\"absolute left-0 md:left-1/2 -translate-x-1/2 w-12 h-12 bg-background border border-primary flex items-center justify-center\"><span class=\"text-primary text-sm font-bold\">01</span></div><div class=\"flex-1 pl-16 md:pl-0 md:pr-24 md:text-right\"><h3 class=\"text-3xl md:text-4xl font-bold uppercase mb-4\">Идея</h3><p class=\"text-muted-foreground text-lg max-w-md\">Каждое украшение начинается с вдохновения — цвета, формы, эмоции. Мы находим красоту в неожиданных местах.</p></div><div class=\"hidden md:block flex-1\"></div></div><div class=\"relative flex flex-col md:flex-row gap-8 md:gap-16 md:flex-row-reverse\" style=\"opacity:0;transform:translateY(40px)\"><div class=\"absolute left-0 md:left-1/2 -translate-x-1/2 w-12 h-12 bg-background border border-primary flex items-center justify-center\"><span class=\"text-primary text-sm font-bold\">02</span></div><div class=\"flex-1 pl-16 md:pl-0 md:pl-24\"><h3 class=\"text-3xl md:text-4xl font-bold uppercase mb-4\">Материалы</h3><p class=\"text-muted-foreground text-lg max-w-md\">Крупный натуральный камень — основа, металл и немного декоративных бусин — акценты. Каждый камень мы выбираем и проверяем лично.</p></div><div class=\"hidden md:block flex-1\"></div></div><div class=\"relative flex flex-col md:flex-row gap-8 md:gap-16 md:flex-row\" style=\"opacity:0;transform:translateY(40px)\"><div class=\"absolute left-0 md:left-1/2 -translate-x-1/2 w-12 h-12 bg-background border border-primary flex items-center justify-center\"><span class=\"text-primary text-sm font-bold\">03</span></div><div class=\"flex-1 pl-16 md:pl-0 md:pr-24 md:text-right\"><h3 class=\"text-3xl md:text-4xl font-bold uppercase mb-4\">Создание</h3><p class=\"text-muted-foreground text-lg max-w-md\">Часы кропотливой работы, внимание к каждой детали. Руки мастера превращают материалы в искусство.</p></div><div class=\"hidden md:block flex-1\"></div></div><div class=\"relative flex flex-col md:flex-row gap-8 md:gap-16 md:flex-row-reverse\" style=\"opacity:0;transform:translateY(40px)\"><div class=\"absolute left-0 md:left-1/2 -translate-x-1/2 w-12 h-12 bg-background border border-primary flex items-center justify-center\"><span class=\"text-primary text-sm font-bold\">04</span></div><div class=\"flex-1 pl-16 md:pl-0 md:pl-24\"><h3 class=\"text-3xl md:text-4xl font-bold uppercase mb-4\">Ваше</h3><p class=\"text-muted-foreground text-lg max-w-md\">Украшение находит своего человека. История продолжается — теперь уже вашими руками.</p></div><div class=\"hidden md:block flex-1\"></div></div></div></div></div></section><section id=\"about\" class=\"relative py-32 md:py-48 bg-primary text-primary-foreground overflow-hidden\"><div class=\"absolute inset-0 opacity-10\"><svg class=\"w-full h-full\" viewBox=\"0 0 100 100\" preserveAspectRatio=\"none\"><defs><pattern id=\"grid\" width=\"10\" height=\"10\" patternUnits=\"userSpaceOnUse\"><path d=\"M 10 0 L 0 0 0 10\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"0.5\"></path></pattern></defs><rect width=\"100\" height=\"100\" fill=\"url(#grid)\"></rect></svg></div><div class=\"relative px-6 md:px-12\"><div class=\"max-w-7xl mx-auto\"><div class=\"grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24\"><div><span class=\"text-primary-foreground/60 text-sm tracking-[0.3em] uppercase\" style=\"opacity:0\">04 / О нас</span><h2 class=\"text-5xl md:text-6xl lg:text-7xl font-bold uppercase mt-4 mb-8\" style=\"opacity:0;transform:translateY(40px)\">Мы —<br/><span class=\"whitespace-nowrap \">ÁCCENTS</span></h2><div class=\"space-y-6 text-lg text-primary-foreground/80\" style=\"opacity:0\"><p>Небольшая мастерская, где каждое украшение собирается вручную, без спешки и без повторов — сборка всегда в единственном экземпляре. Мы верим, что украшение должно не просто нравиться, а быть тем самым акцентом: завершающим элементом образа.</p><p>Мы работаем с крупными натуральными камнями — нефритом, агатом, кварцем, перламутром и другими минералами преимущественно от 8 мм и выше, чтобы изделия были по-настоящему заметны. Дополняем их металлом — бижутерным сплавом или гематитом — и совсем немного бисером и декоративными бусинами, там, где это нужно для баланса. Но что бы ни легло в основу, результат всегда один: украшение, которое не теряется рядом с вами, а становится тем самым акцентом. Каждый материал мы выбираем осознанно и всегда готовы рассказать, что именно у вас на запястье.</p></div><div class=\"mt-12\" style=\"opacity:0;transform:translateY(20px)\"><a class=\"group inline-flex items-center gap-4 text-primary-foreground border-b border-primary-foreground/30 pb-2 hover:border-primary-foreground transition-colors\" href=\"#contact\"><span class=\"text-sm uppercase tracking-[0.2em]\">Связаться с нами</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right h-4 w-4 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></a></div></div><div class=\"flex flex-col justify-center\"><div class=\"grid grid-cols-1 gap-8\"><div class=\"border-l-2 border-primary-foreground/20 pl-8\" style=\"opacity:0;transform:translateX(40px)\"><span class=\"text-6xl md:text-7xl lg:text-8xl font-bold\">500+</span><p class=\"text-primary-foreground/60 text-sm uppercase tracking-widest mt-2\">Украшений создано</p></div><div class=\"border-l-2 border-primary-foreground/20 pl-8\" style=\"opacity:0;transform:translateX(40px)\"><span class=\"text-6xl md:text-7xl lg:text-8xl font-bold\">3</span><p class=\"text-primary-foreground/60 text-sm uppercase tracking-widest mt-2\">Года опыта</p></div><div class=\"border-l-2 border-primary-foreground/20 pl-8\" style=\"opacity:0;transform:translateX(40px)\"><span class=\"text-6xl md:text-7xl lg:text-8xl font-bold\">100%</span><p class=\"text-primary-foreground/60 text-sm uppercase tracking-widest mt-2\">Ручная работа</p></div></div></div></div></div></div></section><section id=\"contact\" class=\"relative py-32 md:py-48\"><div class=\"px-6 md:px-12\"><div class=\"max-w-7xl mx-auto\"><div class=\"grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24\"><div><span class=\"text-primary text-sm tracking-[0.3em] uppercase\" style=\"opacity:0\">05 / Контакт</span><h2 class=\"text-5xl md:text-6xl lg:text-7xl font-bold uppercase mt-4 mb-8\" style=\"opacity:0;transform:translateY(40px)\">Давайте<br/><span class=\"text-primary\">создадим</span></h2><p class=\"text-muted-foreground text-lg max-w-md mb-12\" style=\"opacity:0\">Хотите уникальное украшение на заказ? Или просто хотите сказать привет? Мы всегда рады новым знакомствам.</p><div class=\"mb-16\" style=\"opacity:0;transform:translateY(20px)\"><p class=\"text-sm uppercase tracking-widest text-muted-foreground mb-4\">Подпишитесь на новинки</p><form class=\"flex\"><input type=\"email\" placeholder=\"Ваш email\" class=\"flex-1 bg-transparent border border-border px-4 py-3 text-foreground placeholder:text-muted-foreground focus:outline-none focus:border-primary transition-colors\" value=\"\"/><button type=\"submit\" class=\"bg-primary text-primary-foreground px-6 py-3 hover:bg-primary/90 transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-send h-5 w-5\" aria-hidden=\"true\"><path d=\"M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z\"></path><path d=\"m21.854 2.147-10.94 10.939\"></path></svg></button></form></div><div class=\"flex gap-8\" style=\"opacity:0\"><a class=\"group flex items-center gap-2 text-sm uppercase tracking-widest text-muted-foreground hover:text-primary transition-colors\" href=\"#\">Instagram<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-3 w-3 transition-transform group-hover:translate-x-1\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a><a class=\"group flex items-center gap-2 text-sm uppercase tracking-widest text-muted-foreground hover:text-primary transition-colors\" href=\"#\">Telegram<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-3 w-3 transition-transform group-hover:translate-x-1\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a><a class=\"group flex items-center gap-2 text-sm uppercase tracking-widest text-muted-foreground hover:text-primary transition-colors\" href=\"#\">YouTube<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-3 w-3 transition-transform group-hover:translate-x-1\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div><div class=\"flex flex-col justify-center\"><div class=\"space-y-12\" style=\"opacity:0;transform:translateX(40px)\"><div><p class=\"text-sm uppercase tracking-widest text-muted-foreground mb-2\">Email</p><a href=\"mailto:accents@gmail.com\" class=\"text-2xl md:text-3xl font-medium hover:text-primary transition-colors\">accents@gmail.com</a></div><div><p class=\"text-sm uppercase tracking-widest text-muted-foreground mb-2\">Telegram</p><a href=\"#\" class=\"text-2xl md:text-3xl font-medium hover:text-primary transition-colors\">@accents</a></div><div><p class=\"text-sm uppercase tracking-widest text-muted-foreground mb-2\">Локация</p><p class=\"text-2xl md:text-3xl font-medium\">Москва, Россия</p></div></div></div></div></div></div></section><footer class=\"border-t border-border\"><div class=\"px-6 md:px-12 py-16 md:py-24\"><div class=\"max-w-7xl mx-auto\"><div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8\"><div class=\"lg:col-span-1\"><a class=\"inline-block mb-6\" href=\"/\"><span class=\"whitespace-nowrap text-2xl font-bold tracking-[0.3em]\">ÁCCENTS</span></a><p class=\"text-muted-foreground text-sm max-w-xs\">Украшения ручной работы из крупного натурального камня — для тех, кто ценит индивидуальность и знает цену настоящему.</p></div><div><h4 class=\"text-sm uppercase tracking-widest text-muted-foreground mb-6\">Магазин</h4><ul class=\"space-y-4\"><li><a class=\"text-foreground hover:text-primary transition-colors\" href=\"#catalog\">Колье</a></li><li><a class=\"text-foreground hover:text-primary transition-colors\" href=\"#catalog\">Браслеты</a></li><li><a class=\"text-foreground hover:text-primary transition-colors\" href=\"#catalog\">Обвесы</a></li><li><a class=\"text-foreground hover:text-primary transition-colors\" href=\"#lookbook\">Лукбук</a></li></ul></div><div><h4 class=\"text-sm uppercase tracking-widest text-muted-foreground mb-6\">Информация</h4><ul class=\"space-y-4\"><li><a class=\"text-fo